<mxfile host="app.diagrams.net" version="21.0.0">
  <diagram id="asis-03" name="As-Is: Обработка платежей">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- External Entities -->
        <mxCell id="2" value="Пациент" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="130" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="ФНС&#xa;(Налоговая служба)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="380" width="140" height="60" as="geometry"/>
        </mxCell>

        <!-- Processes -->
        <mxCell id="10" value="P3.1: Приём оплаты&#xa;(кассир)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="185" width="160" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="P3.2: Учёт в 1С&#xa;(бухгалтерия)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="270" y="360" width="160" height="80" as="geometry"/>
        </mxCell>

        <!-- Data Stores -->
        <mxCell id="20" value="D1: ККМ&#xa;(физическое устройство)" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="120" width="210" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="21" value="D2: Excel — двойной учёт&#xa;(кассир, общий диск)" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="240" width="210" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="22" value="D3: 1С:Бухгалтерия&#xa;(файловый режим, сервер)" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="540" y="370" width="210" height="60" as="geometry"/>
        </mxCell>

        <!-- Data Flows -->
        <mxCell id="30" value="Сумма оплаты, ФИО&#xa;[PII_BASIC + FINANCIAL]" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" source="2" target="10" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="31" value="Транзакция по TCP/IP&#xa;без шифрования ⚠" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#FF0000;fontColor=#CC0000;" edge="1" source="10" target="20" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="32" value="Ручная запись в Excel ⚠&#xa;(дублирование данных)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#FF0000;fontColor=#CC0000;" edge="1" source="10" target="21" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="33" value="Данные платежа" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" source="10" target="11" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="34" value="Запись в 1С (OLE через сервер)&#xa;шифрование не определено ⚠" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#FF0000;fontColor=#CC0000;" edge="1" source="11" target="22" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="35" value="Налоговая отчётность" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" source="22" target="3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="36" value="Чек (подтверждение)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" source="10" target="2" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="350" y="310"/>
              <mxPoint x="125" y="310"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Security Issues -->
        <mxCell id="40" value="⚠ Проблемы безопасности (As-Is):&#xa;[P-03] ККМ → сервер: TCP/IP без TLS — перехват платёжных данных в сети&#xa;[P-21] Дублирование в Excel и 1С: два хранилища финансовых данных без контроля&#xa;[P-07] Нет RBAC: кассир имеет доступ к данным, которые не нужны ему по роли&#xa;[P-20] Excel с финансовыми данными — на общем диске без разграничения доступа" style="text;html=1;strokeColor=#FF0000;fillColor=#FFE6CC;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;overflow=hidden;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="480" width="700" height="90" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="tobe-03" name="To-Be: Обработка платежей">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- External Entities -->
        <mxCell id="2" value="Пациент" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="130" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="3" value="ФНС&#xa;(Налоговая служба)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="700" y="370" width="140" height="60" as="geometry"/>
        </mxCell>

        <!-- Processes -->
        <mxCell id="10" value="P3.1: Приём оплаты&#xa;[RBAC: роль Кассир]&#xa;[Audit: все транзакции]" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="265" y="180" width="175" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="11" value="P3.2: Учёт в системе&#xa;[RBAC: роль Бухгалтер]&#xa;[Audit]" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="265" y="355" width="175" height="80" as="geometry"/>
        </mxCell>

        <!-- Data Stores - secured -->
        <mxCell id="20" value="D1: ККМ (TLS-соединение)&#xa;[Шифрование in-transit: TLS 1.3]" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="550" y="120" width="240" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="22" value="D2: Финансовая БД / 1С (единое хранилище)&#xa;[Шифрование: AES-256 at-rest]&#xa;[Tag: FINANCIAL, sensitivity:high]&#xa;[Без дублирования в Excel]" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="550" y="260" width="260" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="23" value="D3: Журнал аудита&#xa;[immutable log]" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="265" y="510" width="220" height="60" as="geometry"/>
        </mxCell>

        <!-- Data Flows - secured -->
        <mxCell id="30" value="Оплата [TLS 1.3]" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#0066CC;fontColor=#004499;" edge="1" source="2" target="10" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="31" value="Транзакция [TLS 1.3]&#xa;(нет незашифрованного TCP)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#006600;fontColor=#004400;" edge="1" source="10" target="20" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="33" value="Данные платежа [TLS]" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#0066CC;" edge="1" source="10" target="11" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="34" value="Запись в БД [зашифровано]&#xa;[FINANCIAL tag]" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#006600;fontColor=#004400;" edge="1" source="11" target="22" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="35" value="Налоговая отчётность" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" source="22" target="3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="36" value="Чек [TLS]" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#0066CC;" edge="1" source="10" target="2" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="352" y="320"/>
              <mxPoint x="125" y="320"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="37" value="Событие аудита" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#9673a6;" edge="1" source="10" target="23" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Security measures note -->
        <mxCell id="40" value="✅ Меры безопасности (To-Be):&#xa;[TLS 1.3] ККМ → сервер: шифрованное соединение (устранение P-03)&#xa;[Единое хранилище] Ликвидация дублирования в Excel (устранение P-21)&#xa;[RBAC] Кассир: только FINANCIAL платежи; Бухгалтер: FINANCIAL полный&#xa;[AES-256] Финансовые данные зашифрованы at-rest&#xa;[Audit] Все транзакции логируются с привязкой к пользователю" style="text;html=1;strokeColor=#006600;fillColor=#d5e8d4;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;overflow=hidden;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="480" width="480" height="110" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
