  <diagram id="tobe-02" name="To-Be: Медицинская консультация">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- External Entities -->
        <mxCell id="2" value="Пациент" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="3" value="Врач / Медицинский&#xa;специалист" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="130" height="60" as="geometry" />
        </mxCell>
        <!-- Processes -->
        <mxCell id="10" value="P2.1: Доступ к карте&#xa;[RBAC: только лечащий врач]&#xa;[ABAC: только свои пациенты]&#xa;[MFA обязателен]" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="260" y="80" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="11" value="P2.2: Консультация&#xa;[Audit: все просмотры]" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="240" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="12" value="P2.3: Обновление карты&#xa;[Audit: все изменения + diff]" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="370" width="190" height="70" as="geometry" />
        </mxCell>
        <!-- Data Stores - secured -->
        <mxCell id="20" value="D1: Медицинские карты / PostgreSQL&#xa;[Шифрование: AES-256 at-rest]&#xa;[Tag: SPD_HEALTH, sensitivity:critical]&#xa;[RLS: врач видит только своих пациентов]" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="560" y="90" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="21" value="D2: Результаты анализов&#xa;[Шифрование: AES-256 at-rest]&#xa;[Tag: SPD_LAB, sensitivity:critical]" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="560" y="260" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="23" value="D3: Журнал аудита&#xa;[immutable, хранение 25 лет по 323-ФЗ]" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="260" y="510" width="260" height="60" as="geometry" />
        </mxCell>
        <!-- Data Flows - secured -->
        <mxCell id="30" value="Жалобы, симптомы [TLS]" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#0066CC;fontColor=#004499;" edge="1" source="2" target="11" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="31" value="Запрос карты (аутентифицирован + MFA)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#0066CC;fontColor=#004499;" edge="1" source="3" target="10" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="32" value="Данные карты [зашифровано TLS]&#xa;[только своего пациента]" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#006600;fontColor=#004400;" edge="1" source="20" target="10" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="33" value="Карта врачу [TLS, аудит чтения]" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#006600;fontColor=#004400;" edge="1" source="10" target="11" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="34" value="Анализы [TLS, аудит чтения]" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#006600;fontColor=#004400;" edge="1" source="21" target="11" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="35" value="Диагноз, назначения [TLS]" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#0066CC;" edge="1" source="11" target="12" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="36" value="Обновление [зашифровано, diff в аудит]" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#006600;fontColor=#004400;" edge="1" source="12" target="20" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="450" y="405" />
              <mxPoint x="450" y="130" />
              <mxPoint x="560" y="130" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="37" value="Событие аудита (read/write)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#9673a6;" edge="1" source="10" target="23" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="38" value="Событие аудита (update)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#9673a6;" edge="1" source="12" target="23" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Security measures note -->
        <mxCell id="40" value="✅ Меры безопасности (To-Be):&#xa;[ABAC] PostgreSQL RLS: врач видит только карты своих пациентов&#xa;[MFA] Обязательный второй фактор для доступа к SPD_HEALTH&#xa;[Audit] Каждое чтение и изменение карты = запись в D3&#xa;[AES-256] Медицинские данные зашифрованы at-rest&#xa;[Хранение] Аудит-лог 25 лет (323-ФЗ о медицинской тайне)" style="text;html=1;strokeColor=#006600;fillColor=#d5e8d4;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;overflow=hidden;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="400" width="430" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
