  <diagram id="tobe-01" name="To-Be: Регистрация пациента">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- External Entities -->
        <mxCell id="2" value="Пациент" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="230" width="130" height="60" as="geometry" />
        </mxCell>
        <!-- Processes -->
        <mxCell id="3" value="P1: Регистрация пациента&#xa;[RBAC: роль Ресепшен]&#xa;[MFA для входа]&#xa;[Audit: все операции]" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="260" y="200" width="190" height="100" as="geometry" />
        </mxCell>
        <!-- Data Stores - secured -->
        <mxCell id="4" value="D1: CRM / PostgreSQL&#xa;[Шифрование at-rest: AES-256]&#xa;[Tag: PII_BASIC, PII_EXTENDED]&#xa;[RLS: только роль Ресепшен]" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="560" y="140" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="5" value="D2: Система записей / PostgreSQL&#xa;[Шифрование at-rest: AES-256]&#xa;[Tag: APPOINTMENT]" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="560" y="300" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="6" value="D3: Журнал аудита&#xa;[immutable log, хранение 5 лет]" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="260" y="390" width="240" height="60" as="geometry" />
        </mxCell>
        <!-- Data Flows - secured -->
        <mxCell id="10" value="ФИО, ДР, телефон, email&#xa;[TLS 1.3]&#xa;[Tag: PII_BASIC]" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#0066CC;fontColor=#004499;" edge="1" source="2" target="3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="11" value="Данные пациента [зашифровано]&#xa;[Tag: PII_BASIC, PII_EXTENDED]" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#006600;fontColor=#004400;" edge="1" source="3" target="4" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="12" value="Запись [зашифровано]&#xa;[Tag: APPOINTMENT]" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#006600;fontColor=#004400;" edge="1" source="3" target="5" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="13" value="Событие аудита" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#9673a6;" edge="1" source="3" target="6" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="14" value="Подтверждение [TLS 1.3]" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#0066CC;fontColor=#004499;" edge="1" source="3" target="2" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="355" y="460" />
              <mxPoint x="125" y="460" />
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- Security measures note -->
        <mxCell id="20" value="✅ Меры безопасности (To-Be):&#xa;[TLS 1.3] Шифрование всех передач данных&#xa;[AES-256] Шифрование хранилища at-rest&#xa;[RBAC] Роль &quot;Ресепшен&quot;: только PII_BASIC + APPOINTMENT&#xa;[Audit] Каждое обращение к ПД фиксируется в D3&#xa;[Data Minimization] Сбор только необходимых данных" style="text;html=1;strokeColor=#006600;fillColor=#d5e8d4;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;overflow=hidden;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="430" width="420" height="110" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
