  </diagram>
  <diagram id="tobe-05" name="To-Be: Аналитика и отчётность">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- External Entities -->
        <mxCell id="2" value="Бизнес-аналитик&#xa;[RBAC: роль Аналитик]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="3" value="Руководство" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="350" width="130" height="60" as="geometry" />
        </mxCell>
        <!-- Processes -->
        <mxCell id="10" value="P5.1: ETL-пайплайн&#xa;[Контролируемая выгрузка]&#xa;[Обезличивание: PII → псевдоним]&#xa;[SPD → агрегат без идентификаторов]" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="255" y="100" width="210" height="110" as="geometry" />
        </mxCell>
        <mxCell id="11" value="P5.2: Аналитика&#xa;(BI-инструмент / Jupyter)&#xa;[Только обезличенные данные]&#xa;[Среда без доступа в интернет]" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="255" y="285" width="210" height="100" as="geometry" />
        </mxCell>
        <mxCell id="12" value="P5.3: Формирование отчётов&#xa;[Данные без ПД]" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="255" y="450" width="210" height="70" as="geometry" />
        </mxCell>
        <!-- Data Stores - secured -->
        <mxCell id="20" value="D1: Исходные данные (БД)&#xa;[Полные ПД — только для систем]&#xa;[Аналитику недоступно напрямую]" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="570" y="90" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="21" value="D2: Аналитическое озеро данных&#xa;[Только обезличенные данные]&#xa;[Tag: sensitivity:medium (нет PII)]&#xa;[Data lineage: источник → витрина]" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="570" y="270" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="22" value="D3: Отчёты (агрегированные)&#xa;[Нет ПД в отчётах]" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="570" y="450" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="23" value="D4: Журнал аудита + Data Lineage&#xa;[Все ETL-операции логируются]" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="255" y="570" width="260" height="60" as="geometry" />
        </mxCell>
        <!-- Data Flows - secured -->
        <mxCell id="30" value="Запрос через BI-интерфейс&#xa;[RBAC: только обезличенные данные]" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#0066CC;fontColor=#004499;" edge="1" source="2" target="11" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="31" value="Полные данные (только ETL-сервис)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" source="20" target="10" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="32" value="Обезличенные данные [TLS]&#xa;(PII и SPD удалены/агрегированы)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#006600;fontColor=#004400;" edge="1" source="10" target="21" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="33" value="Данные для анализа (без ПД)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" source="21" target="11" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="34" value="Агрегированные метрики (без ПД)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" source="11" target="12" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="35" value="Отчёт сохранён (нет ПД)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" source="12" target="22" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="36" value="Отчёт руководству" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" source="22" target="3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="37" value="Data lineage + аудит ETL" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#9673a6;" edge="1" source="10" target="23" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Security measures note -->
        <mxCell id="40" value="✅ Меры безопасности (To-Be):&#xa;[Обезличивание] ETL-пайплайн удаляет/агрегирует все PII и SPD перед передачей в аналитику&#xa;[Data Minimization] Аналитик работает только с обезличенными данными — без доступа к ПД&#xa;[Изоляция] Аналитическая среда изолирована; нет прямого доступа к исходным данным&#xa;[Data Lineage] Полный аудит: какие данные, откуда взяты, как трансформированы, кто видел&#xa;[RBAC] Роль &quot;Аналитик&quot;: только D2 (аналитическое озеро без ПД)" style="text;html=1;strokeColor=#006600;fillColor=#d5e8d4;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;overflow=hidden;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="490" width="490" height="115" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
