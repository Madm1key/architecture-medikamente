        <mxCell id="11" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="P5.2: Обработка данных&#xa;(Jupyter/Python)" vertex="1">
          <mxGeometry height="75" width="160" x="265" y="257.5" as="geometry" />
        </mxCell>
        <mxCell id="12" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="P5.3: Формирование&#xa;отчётов" vertex="1">
          <mxGeometry height="75" width="160" x="265" y="376.5" as="geometry" />
        </mxCell>
        <mxCell id="20" parent="1" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" value="D1: Excel-файлы с данными&#xa;(включают ПД пациентов!)" vertex="1">
          <mxGeometry height="60" width="240" x="690" y="112.5" as="geometry" />
        </mxCell>
        <mxCell id="21" parent="1" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" value="D2: Локальный ноутбук&#xa;аналитика (копия данных!)" vertex="1">
          <mxGeometry height="60" width="240" x="690" y="265" as="geometry" />
        </mxCell>
        <mxCell id="22" parent="1" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" value="D3: Отчёты (Excel/файлы)" vertex="1">
          <mxGeometry height="60" width="240" x="690" y="384" as="geometry" />
