        <mxCell id="30" edge="1" parent="1" source="2" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#FF0000;fontColor=#CC0000;" target="10" value="Запрос данных (нет контроля ⚠)">
