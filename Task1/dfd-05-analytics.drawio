        <mxCell id="10" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="P5.1: Выгрузка данных&#xa;из Excel" vertex="1">
          <mxGeometry height="75" width="160" x="265" y="105" as="geometry" />
