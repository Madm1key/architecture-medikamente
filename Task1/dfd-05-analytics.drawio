  <diagram id="tobe-05" name="To-Be: Аналитика и отчётность">
    <mxGraphModel dx="2066" dy="1119" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;fontStyle=1;fontSize=10;" value="Бизнес-аналитик&#xa;[RBAC: роль Аналитик]" vertex="1">
          <mxGeometry height="60" width="140" x="60" y="220" as="geometry" />
        </mxCell>
        <mxCell id="3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;fontStyle=1;fontSize=12;" value="Руководство" vertex="1">
          <mxGeometry height="60" width="130" x="700" y="350" as="geometry" />
        </mxCell>
        <mxCell id="10" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" value="P5.1: ETL-пайплайн&#xa;[Контролируемая выгрузка]&#xa;[Обезличивание: PII → псевдоним]&#xa;[SPD → агрегат без идентификаторов]" vertex="1">
          <mxGeometry height="110" width="210" x="280" y="25" as="geometry" />
        </mxCell>
        <mxCell id="11" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" value="P5.2: Аналитика&#xa;(BI-инструмент / Jupyter)&#xa;[Только обезличенные данные]&#xa;[Среда без доступа в интернет]" vertex="1">
          <mxGeometry height="100" width="210" x="255" y="285" as="geometry" />
        </mxCell>
        <mxCell id="12" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" value="P5.3: Формирование отчётов&#xa;[Данные без ПД]" vertex="1">
          <mxGeometry height="70" width="210" x="255" y="450" as="geometry" />
        </mxCell>
        <mxCell id="20" parent="1" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" value="D1: Исходные данные (БД)&#xa;[Полные ПД — только для систем]&#xa;[Аналитику недоступно напрямую]" vertex="1">
          <mxGeometry height="80" width="260" x="1280" y="55" as="geometry" />
        </mxCell>
        <mxCell id="21" parent="1" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" value="D2: Аналитическое озеро данных&#xa;[Только обезличенные данные]&#xa;[Tag: sensitivity:medium (нет PII)]&#xa;[Data lineage: источник → витрина]" vertex="1">
          <mxGeometry height="90" width="260" x="570" y="270" as="geometry" />
        </mxCell>
        <mxCell id="22" parent="1" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" value="D3: Отчёты (агрегированные)&#xa;[Нет ПД в отчётах]" vertex="1">
          <mxGeometry height="60" width="260" x="570" y="450" as="geometry" />
        </mxCell>
        <mxCell id="23" parent="1" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" value="D4: Журнал аудита + Data Lineage&#xa;[Все ETL-операции логируются]" vertex="1">
          <mxGeometry height="60" width="260" x="255" y="570" as="geometry" />
        </mxCell>
        <mxCell id="30" edge="1" parent="1" source="2" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#0066CC;fontColor=#004499;" target="11" value="Запрос через BI-интерфейс&#xa;[RBAC: только обезличенные данные]">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="31" edge="1" parent="1" source="20" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" target="10" value="Полные данные (только ETL-сервис)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="32" edge="1" parent="1" source="10" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#006600;fontColor=#004400;" target="21" value="Обезличенные данные [TLS]&#xa;(PII и SPD удалены/агрегированы)">
          <mxGeometry relative="1" x="-0.3684" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="33" edge="1" parent="1" source="21" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" target="11" value="Данные для анализа (без ПД)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="34" edge="1" parent="1" source="11" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" target="12" value="Агрегированные метрики (без ПД)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="35" edge="1" parent="1" source="12" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" target="22" value="Отчёт сохранён (нет ПД)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="36" edge="1" parent="1" source="22" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" target="3" value="Отчёт руководству">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="37" edge="1" parent="1" source="10" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#9673a6;" target="23" value="Data lineage + аудит ETL">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="40" parent="1" style="text;html=1;strokeColor=#006600;fillColor=#d5e8d4;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;overflow=hidden;fontSize=10;" value="✅ Меры безопасности (To-Be):&#xa;[Обезличивание] ETL-пайплайн удаляет/агрегирует все PII и SPD перед передачей в аналитику&#xa;[Data Minimization] Аналитик работает только с обезличенными данными — без доступа к ПД&#xa;[Изоляция] Аналитическая среда изолирована; нет прямого доступа к исходным данным&#xa;[Data Lineage] Полный аудит: какие данные, откуда взяты, как трансформированы, кто видел&#xa;[RBAC] Роль &quot;Аналитик&quot;: только D2 (аналитическое озеро без ПД)" vertex="1">
          <mxGeometry height="115" width="490" x="55" y="490" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
