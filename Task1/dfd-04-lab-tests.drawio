  <diagram id="tobe-04" name="To-Be: Лабораторные анализы">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- External Entities -->
        <mxCell id="2" value="Врач / Специалист" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="3" value="Пациент" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#555555;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="130" height="60" as="geometry" />
        </mxCell>
        <mxCell id="4" value="Внешняя лаборатория&#xa;[DPA подписан]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="200" width="160" height="60" as="geometry" />
        </mxCell>
        <!-- Processes -->
        <mxCell id="10" value="P4.1: Направление на анализы&#xa;[RBAC: роль Врач]&#xa;[Псевдонимизация для лаборатории]" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="260" y="80" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="11" value="P4.2: Получение и хранение&#xa;результатов&#xa;[Автоматическое шифрование]&#xa;[Привязка к пациенту по ID]" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="260" y="300" width="200" height="90" as="geometry" />
        </mxCell>
        <!-- Data Stores - secured -->
        <mxCell id="20" value="D1: Результаты анализов / БД&#xa;[Шифрование: AES-256 at-rest]&#xa;[Tag: SPD_LAB, sensitivity:critical]&#xa;[RBAC: только лечащий врач]" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="550" y="300" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="21" value="D2: Медицинские карты / БД&#xa;[Шифрование: AES-256]&#xa;[ABAC: только свои пациенты]" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="550" y="90" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="23" value="D3: Журнал аудита&#xa;[immutable log]" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="260" y="470" width="220" height="60" as="geometry" />
        </mxCell>
        <!-- Data Flows - secured -->
        <mxCell id="30" value="Запрос (аутентифицирован + MFA)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#0066CC;" edge="1" source="2" target="10" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="31" value="Псевдонимизированные данные + направление&#xa;[SFTP / TLS API]&#xa;[DPA: лаборатория — обработчик ПД]" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#006600;fontColor=#004400;" edge="1" source="10" target="4" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="460" y="125" />
              <mxPoint x="780" y="125" />
              <mxPoint x="780" y="200" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="32" value="Пациент является на сдачу" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;" edge="1" source="3" target="4" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="125" y="360" />
              <mxPoint x="125" y="460" />
              <mxPoint x="780" y="460" />
              <mxPoint x="780" y="260" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="33" value="Результаты [SFTP шифрование]&#xa;[псевдоним → расшифровка ID]" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#006600;fontColor=#004400;" edge="1" source="4" target="11" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="780" y="310" />
              <mxPoint x="460" y="310" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="34" value="Зашифровано, с тегом SPD_LAB" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#006600;fontColor=#004400;" edge="1" source="11" target="20" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="35" value="Доступ через API (RBAC + ABAC)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#0066CC;" edge="1" source="2" target="21" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="36" value="Событие аудита (доступ к SPD)" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#9673a6;" edge="1" source="11" target="23" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Security measures note -->
        <mxCell id="40" value="✅ Меры безопасности (To-Be):&#xa;[DPA] Договор об обработке ПД с лабораторией (устранение P-22, P-14)&#xa;[Псевдонимизация] Лаборатория получает не ФИО, а псевдоним — минимизация данных&#xa;[SFTP/TLS] Шифрованный канал передачи данных в лабораторию&#xa;[AES-256 + RBAC] Результаты зашифрованы; доступ — только лечащий врач&#xa;[Audit] Каждый доступ к SPD_LAB логируется" style="text;html=1;strokeColor=#006600;fillColor=#d5e8d4;align=left;verticalAlign=top;spacingLeft=8;spacingRight=8;overflow=hidden;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="55" y="480" width="470" height="115" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
