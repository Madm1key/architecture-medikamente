          <mxGeometry height="60" width="140" x="370" y="325" as="geometry" />
        </mxCell>
        <mxCell id="10" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="P4.1: Направление&#xa;на анализы" vertex="1">
          <mxGeometry height="70" width="160" x="360" y="95" as="geometry" />
