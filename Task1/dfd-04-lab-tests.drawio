        <mxCell id="33" edge="1" parent="1" source="4" style="edgeStyle=orthogonalEdgeStyle;html=1;fontSize=9;strokeColor=#FF0000;fontColor=#CC0000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="11" value="Результаты (PDF/JPG)&#xa;нешифрованная передача ⚠">
