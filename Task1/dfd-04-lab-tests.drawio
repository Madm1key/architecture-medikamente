        </mxCell>
        <mxCell id="20" parent="1" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" value="D2: Результаты анализов&lt;br&gt;(PDF/JPG, общий диск)" vertex="1">
          <mxGeometry height="60" width="220" x="640" y="180" as="geometry" />
        </mxCell>
        <mxCell id="21" parent="1" style="shape=mxgraph.dfd.dataStore;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" value="D1: Медицинские карты&lt;br&gt;(Excel, общий диск)" vertex="1">
          <mxGeometry height="60" width="220" x="640" y="35" as="geometry" />
